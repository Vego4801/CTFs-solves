<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bobby's Bistro</title>

		<link rel="stylesheet" href="/static/css/globals.css">
    <link rel="stylesheet" href="/static/css/chat_home.css" />
  </head>

  <body>
		<header class="terminal-nav">
			<div class="terminal-logo" style="margin-right: 1rem;">
				<div class="logo terminal-prompt"><a href="/" style="color: white;">Bobby's Bistro</a></div>
			</div>

			<nav class="terminal-menu">
				<ul>
					<li><a href="/" class="menu-item">Home</a></li>
					<li><a href="/register" class="menu-item">Register</a></li>
					<li><a href="/login" class="menu-item">Login</a></li>
					<li><a href="/chat" class="menu-item">Chat</a></li>
					<li><a href="/announcements" class="menu-item">Announcements</a></li>
					<li><a href="/logout" class="menu-item">Logout</a></li>
					<li><a href="/profile" class="menu-item">Profile</a></li>
				</ul>
			</nav>
		</header>

    <!-- Chat messages -->
    <div id="chatMessages" class="terminal-card" style="width: 80%; max-width: 800px; height: 500px; margin: 2rem auto; overflow-y: auto; padding: 1rem;">
    </div>
		
    <!-- Chat form -->
		<form id="chatForm" action="/api/chat-messages" method="POST" enctype="multipart/form-data" class="form terminal-card" style="width: 80%; max-width: 800px; margin: 1rem auto; padding: 1rem;">
			<div class="form-group">
				<input type="text" name="message" id="message" placeholder="Type a message..." autocomplete="off" required>
			</div>

			<div class="form-group" style="display: flex; align-items: center; justify-content: space-between;">
				<input type="file" id="attachment" name="attachment" style="flex: 1;">
				<button type="submit" class="btn btn-primary" style="margin-left: 1rem;">Send</button>
			</div>
		</form>

    <script src="/static/js/chat_home.js"></script>
  </body>
</html>

