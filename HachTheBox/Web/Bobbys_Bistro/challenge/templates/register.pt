<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Register</title>
	<link rel="stylesheet" href="/static/css/globals.css">
</head>
<body>
	<header class="terminal-nav">
      <div class="terminal-logo" style="margin-right: 1rem;">
        <div class="logo terminal-prompt"><a href="/" style="color: white;">Bobby's Bistro</a></div>
      </div>

      <nav class="terminal-menu">
        <ul>
          <li><a href="/" class="menu-item">Home</a></li>
          <li><a href="/register" class="menu-item">Register</a></li>
					<li><a href="/login" class="menu-item">Login</a></li>
          <li><a href="/chat" class="menu-item">Chat</a></li>
					<li><a href="/logout" class="menu-item">Logout</a></li>
        </ul>
      </nav>
  </header>

	<div class="content" style="display: flex; flex-direction: column; justify-content: center; align-items: center;">
		<h1 style="text-align: center; margin-top: 2rem;">Registration</h1>

		<form action="/register" method="POST" class="form terminal-card" style="max-width: 400px; margin: 2rem auto; padding: 2rem;">
			<div class="form-group">
				<label for="username">Username</label>
				<input type="text" name="username" id="username" placeholder="username" required>
			</div>

			<div class="form-group">
				<label for="password">Password</label>
				<input type="password" name="password" id="password" placeholder="password" required>
			</div>

			<button type="submit" class="btn btn-primary btn-block">Submit</button>
		</form>
	</div>

	<p class="message" style="text-align: center;">${message}</p>
</body>
</html>

