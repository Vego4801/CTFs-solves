<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Bobby's Bistro</title>
	<link rel="stylesheet" href="/static/css/globals.css">
</head>
<body>
	<header class="terminal-nav">
		<div class="terminal-logo" style="margin-right: 1rem;">
			<div class="logo terminal-prompt">
				<a href="/" style="color: white;">Bobby's Bistro</a>
			</div>
		</div>
		<nav class="terminal-menu">
			<ul>
				<li><a href="/" class="menu-item">Home</a></li>
				<li><a href="/register" class="menu-item">Register</a></li>
				<li><a href="/login" class="menu-item">Login</a></li>
				<li><a href="/chat" class="menu-item">Chat</a></li>
				<li><a href="/announcements" class="menu-item">Announcements</a></li>
				<li><a href="/profile" class="menu-item">Profile</a></li>
			</ul>
		</nav>
	</header>

	<main class="container" style="max-width: 700px; margin: 3rem auto;">
		<h1 style="text-align: center;">User Profile</h1>

		<div class="profile-data" tal:repeat="i user_data">
			<div class="terminal-card terminal-alert terminal-alert-primary" style="margin-top: 2rem; padding: 1.5rem;">
				<ul style="list-style-type: none; margin: 0; padding: 0;">
					<li><strong>User ID:</strong> ${i.id}</li>
					<li><strong>Username:</strong> ${i.username}</li>
					<li><strong>Role:</strong> ${i.role}</li>
				</ul>
			</div>
		</div>
	</main>

	<form action="/profile" method="POST" hidden id="token-form" name="token-form">
		<input type="text" name="token" hidden value="${token}">
		<button type="submit" hidden></button>
	</form>

	<script type="text/javascript">
		window.addEventListener("DOMContentLoaded", function () {
			// Check if form was already submitted during this session
			if (!sessionStorage.getItem("profileFormSubmitted")) {
				const form = document.getElementById("token-form");
				if (form) {
					form.submit();
					sessionStorage.setItem("profileFormSubmitted", "true");
				}
			}
		});
	</script>
</body>
</html>

