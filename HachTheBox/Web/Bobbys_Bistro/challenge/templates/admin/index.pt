<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Announcements</title>
	<link rel="stylesheet" href="/static/css/globals.css">
</head>
<body>
	<header class="terminal-nav">
		<div class="terminal-logo" style="margin-right: 1rem;">
			<div class="logo terminal-prompt">
				<a href="/" style="color: white;">Bobby's Bistro</a>
			</div>
		</div>
		<nav class="terminal-menu">
			<ul>
				<li><a href="/" class="menu-item">Home</a></li>
				<li><a href="/register" class="menu-item">Register</a></li>
				<li><a href="/login" class="menu-item">Login</a></li>
				<li><a href="/chat" class="menu-item">Chat</a></li>
				<li><a href="/announcements" class="menu-item">Announcements</a></li>
				<li><a href="/logout" class="menu-item">Logout</a></li>
				<li><a href="/profile?token=${token}" class="menu-item">Profile</a></li>
			</ul>
		</nav>
	</header>

	<main class="container" style="max-width: 700px; margin: 2rem auto;">
		<h1 style="text-align: center; margin-bottom: 1.5rem;">Announcements</h1>

		<form action="/api/announcements" method="POST" class="form announcement-form terminal-card" style="padding: 2rem;">
			
			<div class="form-group">
				<label for="title" style="font-weight: bold;">Announcement Title</label>
				<input 
					name="title" 
					id="title" 
					placeholder="Announcement Title"
					type="text"
					required />
			</div>

			<div class="form-group">
				<label for="announcement" style="font-weight: bold;">Announcement</label>
				<textarea 
					name="announcement" 
					id="announcement" 
					placeholder="Write your announcement here..."
					required 
					style="width: 100%; height: 200px;"></textarea>
			</div>

			<div class="form-group">
				<label style="font-weight: bold;">Personalize Announcement?</label><br>
				
				<label for="personalized-true">
					<input type="radio" name="personalized" value="1" id="personalized-true">
					Yes
				</label>

				<label for="personalized-false" style="margin-left: 1rem;">
					<input type="radio" name="personalized" value="0" id="personalized-false" checked>
					No
				</label>
			</div>

			<button type="submit" class="btn btn-primary btn-block">Submit</button>
		</form>
	</main>

	<script src="/static/js/announcements_home.js"></script>
</body>
</html>

